; AnaMark TUN v2 - a factory tuning that ships inside Fiblo Galactic.
; Generated by tools/MakeTunings.ps1 - edit that, not this.
;
; 12 equal divisions of the octave: ordinary equal temperament.
; Included as the CONTROL. Loading it on top of the 12-TET mode must be
; inaudible, note for note - if it is not, the tuning path is wrong and
; not the ear.
;
; Degree 0 is MIDI key 60 at 261.6255653006 Hz (12-TET middle C),
; which is where the plugin anchors a scale's 1/1.

[Info]
Name=12ed2
Author=Fiblo Galactic
Description=12 equal divisions of the octave - standard equal temperament

[Scale Begin]
; 12 degrees per period of 1200.000000 cents
basekey=60
degree 0=0.0000000000
degree 1=100.0000000000
degree 2=200.0000000000
degree 3=300.0000000000
degree 4=400.0000000000
degree 5=500.0000000000
degree 6=600.0000000000
degree 7=700.0000000000
degree 8=800.0000000000
degree 9=900.0000000000
degree 10=1000.0000000000
degree 11=1100.0000000000
degree 12=1200.0000000000
[Scale End]

